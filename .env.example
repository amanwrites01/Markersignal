# =============================================================================
# MAKERSIGNAL environment settings
#
# 1. Copy this file to a new file named exactly:  .env.local
#    (same folder as package.json)
# 2. Fill in the values marked <PASTE…>. See SETUP.md, step 6, for where each
#    value comes from.
# 3. Never commit .env.local or share it publicly.
# =============================================================================

# Address you open the app at. Used in sign-up / password-reset links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (database, login, file storage) --------------------------------
# For local development these come from:  npx supabase status
#   API_URL          -> NEXT_PUBLIC_SUPABASE_URL
#   PUBLISHABLE_KEY  -> NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY
#   SECRET_KEY       -> SUPABASE_SECRET_KEY
NEXT_PUBLIC_SUPABASE_URL=https://wabzwfwpqjytaddpuwgh.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ZYWyCMKjsi8QHWS5O1xkpA_z9UmQJ-o
# Server-only. Never put this in browser code or share it.
SUPABASE_SECRET_KEY=<PASTE SECRET_KEY from "npx supabase status">

# --- Temporary sign-up helper ------------------------------------------------
# true  = sign-up / reset codes are shown on screen (no email needed). Use while
#         real email sending isn't set up.
# false = codes are emailed (requires email/SMTP configured in Supabase).
DEV_SHOW_EMAIL_CODES=true

# --- Google sign-in (optional) -----------------------------------------------
# Set to true only after Google OAuth keys are configured (see README §12).
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false

# --- AI features (optional) --------------------------------------------------
# Provide either GROQ_API_KEY (ultra-fast, free tier available) or ANTHROPIC_API_KEY.
# If both are empty, AI buttons say "unavailable" and deterministic tools still work.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
# low | medium | high  (higher = more thorough, slower, more tokens)
AI_EFFORT=medium
AI_TIMEOUT_MS=60000
AI_DAILY_LIMIT_PER_USER=40
